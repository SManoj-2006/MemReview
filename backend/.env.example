# Copy to .env and fill in
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Hindsight — local (default)
HINDSIGHT_URL=http://localhost:8888
HINDSIGHT_TOKEN=
HINDSIGHT_BANK=memreview-team

# Hindsight — cloud (alternative)
# HINDSIGHT_URL=https://api.hindsight.vectorize.io
# HINDSIGHT_TOKEN=hsk_your_token_here

# Demo safety: true = return canned structured findings when the LLM is
# unavailable (also used automatically on Groq timeout / missing key)
DEMO_MODE=false
